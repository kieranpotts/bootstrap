#!/usr/bin/env bash

#
# Main entry point for the development environment bootstrapper.
#
# Usage: ./run/install [--profile=agent|tui|gui] [--yes]
#
#   --profile=agent   The minimal tooling a coding agent needs to work
#                     unattended in a headless container.
#   --profile=tui     Everything in `agent`, plus the tools that need a human
#                     at a terminal but no display. The default.
#   --profile=gui     Everything in `tui`, plus applications, browsers, and
#                     editors that need a display.
#   -y, --yes         Assume yes to all per-tool install/update prompts.
#   -h, --help        Show this help and exit.
#
# The profiles are cumulative, and `docs/tools.md` lists what each one
# installs. `./run/bootstrap` still exists as a deprecated wrapper around this
# script, for machines/images pinned to older tags. Prefer `./run/install`.
#

# Strict mode for the entry-point script:
#   -e            Exit on any unhandled command failure.
#   -u            Error on references to unset variables.
#   -o pipefail   A pipeline fails if any element fails (not just the last).
#
# Note: the per-step subshells inside `step()` (see `./run/inc/fn/steps.sh`)
# intentionally use `set -e` only, not the full strict mode. That keeps
# individual step files from breaking on unset-var references in the 50+
# install scripts that pre-date the strict-mode convention.

set -euo pipefail

# Use this instead for debugging problems with the script.
#set -euxo pipefail

#
# CLI flag parsing.
#

# Feature toggles:

# Consumed by `is_yes_enabled` in `run/inc/fn/profile.sh`.
# shellcheck disable=SC2034
assume_yes=0

# Consumed by the profile predicates in `run/inc/fn/profile.sh`, and through
# them by the `*_step` wrappers in `run/inc/fn/steps.sh`. Defaults to `tui`:
# a human at a terminal, with no display.
# shellcheck disable=SC2034
profile="tui"

for arg in "$@"; do
  case "${arg}" in
    -y|--yes)
      # shellcheck disable=SC2034
      assume_yes=1
      ;;
    --profile=agent|--profile=tui|--profile=gui)
      # shellcheck disable=SC2034
      profile="${arg#--profile=}"
      ;;
    --gui)
      echo "\`--gui\` has been replaced by \`--profile=gui\`." >&2
      exit 1
      ;;
    -h|--help)
      sed -n '4,19p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown argument: ${arg}" >&2
      echo "Run \`./run/install --help\` to see available options." >&2
      exit 1
      ;;
  esac
done

#
# Global variables.
#

# Absolute path to this repository. This allows sourcing of files relative to
# the repository root, and thus the bootstrap script can be run from any
# working directory.

repo_root=$(dirname "$(dirname "$(readlink -f "$0")")")

# Includes path.
inc_path="${repo_root}/run/inc"

# Determine the bashrc file to use. If the user has a file called
# `local.bashrc` in their home directory, use that instead of the
# default `.bashrc` file.

bashrc="${HOME}/.bashrc"
if [[ -f "${HOME}/local.bashrc" ]]; then
  # `bashrc` is used in sourced files.
  # shellcheck disable=SC2034
  bashrc="${HOME}/local.bashrc"
else
  touch "${HOME}/.bashrc"
fi

# Source ANSI code variables.
. "${inc_path}/var/ansi-codes.sh"

#
# Utility functions.
#

. "${inc_path}/fn/bashrc-protect.sh"
. "${inc_path}/fn/gh-release.sh"
. "${inc_path}/fn/install-steps.sh"
. "${inc_path}/fn/npmrc-protect.sh"
. "${inc_path}/fn/os.sh"
. "${inc_path}/fn/profile.sh"
. "${inc_path}/fn/statuses.sh"
. "${inc_path}/fn/steps.sh"
. "${inc_path}/fn/superdo.sh"

#
# Main script.
#

print_starting

# Snapshot ~/.bashrc so third-party installers that bypass our `${bashrc}`
# routing can be undone at the end of the bootstrap.
bashrc_snapshot

# Strip any ~/.npmrc settings incompatible with NVM, before any step below
# gets a chance to source `nvm.sh` and be broken by them.
npmrc_protect

# Initial system compatibility checks. Sourced directly (not via `step()`)
# so its `exit 1` on an unsupported OS aborts the entire bootstrap.
. "${inc_path}/sys/checks.sh"

# System utilities. Some of these, like curl and wget, are required for
# the package repository setup scripts that follow. These base utilities are
# first-time-only. `run/update` skips them and relies on the machine having
# already been bootstrapped.
step "${inc_path}/util/apt-transport-https.sh"
step "${inc_path}/util/ca-certificates.sh"
step "${inc_path}/util/curl.sh"
step "${inc_path}/util/git.sh"
step "${inc_path}/util/gnupg.sh"
step "${inc_path}/util/htop.sh"
step "${inc_path}/util/icoutils.sh"
step "${inc_path}/util/inotify-tools.sh"
step "${inc_path}/util/jq.sh"
step "${inc_path}/util/lsb-release.sh"
step "${inc_path}/util/make.sh"
step "${inc_path}/util/ripgrep.sh"
step "${inc_path}/util/software-properties-common.sh"
step "${inc_path}/util/tar.sh"
step "${inc_path}/util/unzip.sh"
step "${inc_path}/util/wget.sh"

# Shared install/update step sequence. This is the same sequence
# `run/update` runs, so the two entry points stay in lockstep.
run_install_steps

# Restore ~/.bashrc to its starting state if a third-party
# installer modified it. Any new lines are redirected
# to ~/local.bashrc.
bashrc_restore

# Print outcomes.
print_finished
print_failures

# Exit non-zero if any step failed, so that CI/wrappers
# can detect failures.
exit "${#FAILED_STEPS[@]}"
