#!/bin/bash

#
# Main entry point for the development environment bootstrapper.
#
# Usage: ./run/bootstrap [--gui]
#
#   --gui         Also install GUI applications (in addition to CLI tools).
#   -h, --help    Show this help and exit.
#

# Exit on any error.
set -e

# Use this instead for debugging problems with the script.
#set -euxo pipefail

#
# CLI flag parsing:
#

# Feature toggles. Defaults are conservative: CLI-only.
# Consumed by `is_gui_enabled` in `run/inc/utils.sh` and any GUI install steps.

# `install_gui` is consumed by sourced files.
# shellcheck disable=SC2034
install_gui=0

# Parse CLI flags.
for arg in "$@"; do
  case "${arg}" in
    --gui)
      # shellcheck disable=SC2034
      install_gui=1
      ;;
    -h|--help)
      sed -n '4,11p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown argument: ${arg}" >&2
      echo "Run \`./run/bootstrap --help\` to see available options." >&2
      exit 1
      ;;
  esac
done

#
# Global variables:
#

# Absolute path to this repository. This allows sourcing of files relative to
# the repository root, and thus the bootstrap script can be run from any
# working directory.
#
repo_root=$(dirname "$(dirname "$(readlink -f "$0")")")

# Includes path.
inc_path="${repo_root}/run/inc"

# Determine the bashrc file to use. If the user has a file called
# `local.bashrc` in their home directory, use that instead of the
# default `.bashrc` file.
#
bashrc="${HOME}/.bashrc"
if [ -f "${HOME}/local.bashrc" ]; then
  # `bashrc` is used in sourced files.
  # shellcheck disable=SC2034
  bashrc="${HOME}/local.bashrc"
else
  touch "${HOME}/.bashrc"
fi

# Source ANSI code variables.
source "${inc_path}/var/ansi-codes.sh"

#
# Utility functions:
#

source "${inc_path}/fn/gui.sh"
source "${inc_path}/fn/statuses.sh"
source "${inc_path}/fn/steps.sh"
source "${inc_path}/fn/superdo.sh"

#
# Main script:
#

print_starting

# Initial system compatibility checks and updates.
source "${inc_path}/sys/checks.sh"
source "${inc_path}/sys/apt.sh"
source "${inc_path}/sys/upgrade.sh"

# System utilities. Some of these, like curl and wget, are required for
# the package repository setup scripts that follow.
source "${inc_path}/util/curl.sh"
source "${inc_path}/util/git.sh"
source "${inc_path}/util/gnupg.sh"
source "${inc_path}/util/make.sh"
source "${inc_path}/util/software-properties-common.sh"
source "${inc_path}/util/unzip.sh"
source "${inc_path}/util/wget.sh"

# Install runtime environments.
source "${inc_path}/run/node.sh"
source "${inc_path}/run/jdk.sh"
source "${inc_path}/run/php.sh"
source "${inc_path}/run/python.sh"

# Install dev tools.
source "${inc_path}/dev/chrome.sh"
source "${inc_path}/dev/claude.sh"
source "${inc_path}/dev/copilot.sh"
source "${inc_path}/dev/delta.sh"
source "${inc_path}/dev/gh.sh"
source "${inc_path}/dev/git-lfs.sh"
source "${inc_path}/dev/lazygit.sh"
source "${inc_path}/dev/maven.sh"
source "${inc_path}/dev/neovim.sh"
source "${inc_path}/dev/oh-my-posh.sh"
source "${inc_path}/dev/pre-commit.sh"
source "${inc_path}/dev/shellcheck.sh"
source "${inc_path}/dev/tmux.sh"
source "${inc_path}/dev/vscode.sh"

# Install ops tools.
source "${inc_path}/ops/aws.sh"
source "${inc_path}/ops/terraform.sh"

# Hardware utilities.
source "${inc_path}/phy/rocm.sh"

# Finalize.
source "${inc_path}/sys/teardown.sh"
source "${inc_path}/msg/finish.sh"
