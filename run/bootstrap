#!/usr/bin/env bash

#
# DEPRECATED: `./run/bootstrap` has been renamed to `./run/install`.
#
# This wrapper exists only for machines/images pinned to older tags of this
# repository (eg. `docker-devcontainer` builds). It forwards every argument
# to `./run/install` unchanged. Prefer calling `./run/install` directly —
# this wrapper may be removed in a future release.
#

set -euo pipefail

repo_root=$(dirname "$(dirname "$(readlink -f "$0")")")

echo "WARNING: \`./run/bootstrap\` is deprecated. Use \`./run/install\` instead." >&2

exec "${repo_root}/run/install" "$@"
